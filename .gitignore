# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# git worktrees (local)
/.worktrees/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
devserver*.log
dev_out.log
dev_err.log

# env files (never commit real secrets)
.env
.env.local
.env.*.local
.env*.local
*.env
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Safety script backups (local)
scripts/safety/backups/

# Local lock snapshots (never commit)
backup/locked_*/

# Local full-site zip snapshots (never commit)
backup/site-snapshots/

# Local safety backups (never commit)
.safety-backups/

# Local temp artifacts (never commit)
.tmp*
.tmp*/

# Local temp logs (never commit)
.tmp_*_out.txt
.tmp_git_*.txt

# Playwright artifacts (never commit)
playwright-report/
test-results/

# Gateway audit artifacts (never commit)
.audit/

# Large binary tools
.tools/ffmpeg.zip
.tools/ffmpeg_extract/**


