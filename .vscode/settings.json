{
  // Performance: prevent VS Code from constantly watching/indexing huge build/dependency folders.
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/.swc/**": true,
    "**/.vercel/**": true,
    "**/coverage/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/backup/**": true,
    "**/.safety-backups/**": true,
    "**/database_backup/**": true,
    "**/.itr_store/**": true,
    "**/.incoming_step2/**": true,
    "**/playwright-report/**": true,
    "**/test-results/**": true,
    "**/.tmp*/**": true,
    "**/.tmp_*": true,
    "**/.tmp_*.*": true,
    "**/.turbo/**": true
  },
  "search.exclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/.swc/**": true,
    "**/.vercel/**": true,
    "**/coverage/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/backup/**": true,
    "**/.safety-backups/**": true,
    "**/database_backup/**": true,
    "**/.itr_store/**": true,
    "**/.incoming_step2/**": true,
    "**/playwright-report/**": true,
    "**/test-results/**": true,
    "**/.tmp*/**": true,
    "**/.tmp_*": true,
    "**/.tmp_*.*": true,
    "**/temp-full.json": true,
    "**/*.mp4": true,
    "**/.turbo/**": true
  },
  "files.exclude": {
    "**/.next/**": true,
    "**/.swc/**": true,
    "**/.vercel/**": true,
    "**/coverage/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/backup/**": true,
    "**/.safety-backups/**": true,
    "**/database_backup/**": true,
    "**/.itr_store/**": true,
    "**/.incoming_step2/**": true,
    "**/playwright-report/**": true,
    "**/test-results/**": true,
    "**/.tmp*/**": true,
    "**/.tmp_*": true,
    "**/.tmp_*.*": true,
    "**/temp-full.json": true,
    "**/*.mp4": true
  },

  // Helps on larger JS/TS projects.
  "typescript.tsserver.maxTsServerMemory": 4096,

  // Optional: reduces background Git work on very large repos.
  "git.autorefresh": false,
  "git.autofetch": false,
  "git.untrackedChanges": "hidden",
  "git.decorations.enabled": false,
  "scm.diffDecorations": "none",

  // Reduce background TypeScript downloads/work.
  "typescript.disableAutomaticTypeAcquisition": true,

  // The built-in npm extension can do extra probing on large repos.
  "npm.autoDetect": "off",

  // Defensive: avoid the editor trying to fully load massive single files.
  // (If VS Code detects a file as "large", it will fall back to a lightweight mode.)
  "files.maxMemoryForLargeFilesMB": 64,

  // Prefer respecting .gitignore/.ignore for search. Helps on huge repos.
  "search.useIgnoreFiles": true,
  "search.useGlobalIgnoreFiles": true,
  "chat.tools.terminal.autoApprove": {
    "git add": true,
    "git commit": true,
    "git push": true
  }
}
