# ════════════════════════════════════════════════════════════════════════════
# 🔒 MARKET TICKER API KEYS - COPY TO .env.local (local) and set in Vercel (production)
# ════════════════════════════════════════════════════════════════════════════
#
# HOW TO USE:
# 1. Copy this file to .env.local for local development
# 2. For production: Add these to Vercel Dashboard > Project > Settings > Environment Variables
#
# ════════════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────────────────
# ALPHA VANTAGE - FREE: 25 calls/day
# Used for: USD/INR, Bitcoin (backup)
# Get FREE key: https://www.alphavantage.co/support/#api-key
# ────────────────────────────────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=demo

# ────────────────────────────────────────────────────────────────────────────
# EXCHANGE RATE API - FREE: 1,500 calls/month
# Used for: USD/INR (backup)
# Get FREE key: https://www.exchangerate-api.com/
# ────────────────────────────────────────────────────────────────────────────
EXCHANGE_RATE_API_KEY=

# ────────────────────────────────────────────────────────────────────────────
# GOLD API - FREE: 300 calls/month (OPTIONAL - we have 4 other sources)
# Used for: Gold/Silver prices
# Get FREE key: https://www.goldapi.io/
# ────────────────────────────────────────────────────────────────────────────
GOLDAPI_KEY=

# ════════════════════════════════════════════════════════════════════════════
# FREE SOURCES THAT DON'T NEED API KEYS
# ════════════════════════════════════════════════════════════════════════════
#
# ✅ Google Finance - UNLIMITED - NIFTY, SENSEX, USD/INR
# ✅ CoinGecko - 30/min FREE - Bitcoin
# ✅ Binance - UNLIMITED - Bitcoin
# ✅ MoneyControl - UNLIMITED - All MCX commodities
# ✅ MCX India - UNLIMITED - Gold, Silver, Crude (official)
# ✅ LiveMint - UNLIMITED - Gold, Silver, Crude
# ✅ GoodReturns - UNLIMITED - Gold, Silver
#
# ════════════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────────────────
# NEXT.JS (usually don't change)
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────────────────────
# EMAIL (Resend)
# Used for: form submissions + notifications
#
# Required to send emails:
# - RESEND_API_KEY
# - RESEND_FROM_EMAIL (a verified sender/domain in Resend)
#
# Optional:
# - SUBMISSIONS_NOTIFY_EMAIL (where Impact/Guest submissions are sent)
# ────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUBMISSIONS_NOTIFY_EMAIL=

# ────────────────────────────────────────────────────────────────────────────
# UNSPLASH - FREE: 50 requests/hour (demo mode works without key)
# Used for: Blog Image Generator - automatic unique images for blog posts
# Get FREE key: https://unsplash.com/developers
# Steps: 1) Create account 2) New Application 3) Get Access Key
# ────────────────────────────────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=

