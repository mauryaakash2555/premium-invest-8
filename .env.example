# Copy this file to .env.local and fill in your keys (DO NOT COMMIT .env.local)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_key_here

# AI APIs
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
ANTHROPIC_API_KEY=your_claude_key_here

# Admin security (PHASE 5)
# Use bcrypt hashes (recommended)
SUPER_ADMIN_PASSWORD_HASH=bcrypt_hash_of_your_super_admin_password
FAMILY_ADMIN_PASSWORD_HASH=bcrypt_hash_of_your_family_admin_password

# Session secret (used to sign admin cookie + internal hashing)
# Use a long random string (32+ chars)
ADMIN_SESSION_SECRET=generate_a_random_secret_here

# Optional: separate salt for IP hashing (privacy-safe analytics)
ANALYTICS_SALT=generate_a_random_salt_here

# Feature flags
# - Server runtime flag: FEATURE_* (recommended)
# - Client build-time flag: NEXT_PUBLIC_FEATURE_* (only needed if UI behavior should change)
FEATURE_SMART_SMALLTALK_REDIRECT=true
NEXT_PUBLIC_FEATURE_SMART_SMALLTALK_REDIRECT=true

# Razorpay (Test/Live)
# Required for Orders API + Checkout flow used by /api/razorpay/create-order and /api/razorpay/verify
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Backward compatibility (older deployments)
# ADMIN_PASSWORD_HASH=legacy_bcrypt_hash_for_super_admin

