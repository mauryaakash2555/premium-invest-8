# Frontend Environment Variables
REACT_APP_RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here
REACT_APP_BACKEND_URL=http://localhost:8000

# Backend Environment Variables
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key-here
MONGO_URL=mongodb://localhost:27017
DB_NAME=test_database
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Optional: Disable auto-seeding of blog data (useful for testing or when you want to manually control seeding)
# Default is "true" - set to "false" to disable
ENABLE_AUTO_SEED=true
