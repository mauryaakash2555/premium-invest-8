# Copy this file to .env.local and fill in your keys (DO NOT COMMIT .env.local)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_key_here

# AI APIs
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
ANTHROPIC_API_KEY=your_claude_key_here

# Admin security (PHASE 5)
# Use bcrypt hashes (recommended)
ADMIN_PASSWORD_HASH=bcrypt_hash_of_your_admin_password
FAMILY_ADMIN_PASSWORD_HASH=bcrypt_hash_of_your_family_password

# Session secret (used to sign admin cookie + internal hashing)
# Use a long random string (32+ chars)
ADMIN_SESSION_SECRET=generate_a_random_secret_here

# Optional: separate salt for IP hashing (privacy-safe analytics)
ANALYTICS_SALT=generate_a_random_salt_here
