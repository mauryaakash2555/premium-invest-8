{
  "version": 2,
  "buildCommand": "if [ -d frontend ]; then cd frontend && npm install --legacy-peer-deps && npm run build; else echo 'Frontend directory not found'; exit 1; fi",
  "outputDirectory": "frontend/build",
  "devCommand": "cd frontend && npm start",
  "framework": "create-react-app",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/build/$1"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
